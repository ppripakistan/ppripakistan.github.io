                    e.stopPropagation();
                    if (jQuery(window).width() < 980) {
                        $(this).after($(".popup"));
                        $('.popup').show().addClass('popup-mobile').css('top', 0);
                        $('html, body').animate({
                            scrollTop: $('.popup').offset().top
                        }, 500);
                    } else {
